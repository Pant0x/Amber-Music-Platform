{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Amber Music",
  "version": "1.0.0",
  "identifier": "com.pant0x.ambermusic",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../.next/standalone"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Amber Music",
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "width": 1280,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' data: blob: https:; connect-src 'self' https: wss:; img-src 'self' data: blob: https:; media-src 'self' https: blob:; font-src 'self' data: https:; style-src 'self' 'unsafe-inline' https:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Music",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      },
      "rpm": {
        "depends": ["webkit2gtk4.1", "gtk3", "libayatana-appindicator-gtk3"],
        "recommends": ["gstreamer1-plugins-good", "gstreamer1-plugin-libav"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "RWQVQ077AyQURpnul1dLOkUns/ghayI4/JRGAD+KmtrUWLUN5HRoYZ5v",
      "endpoints": [
        "https://github.com/Pant0x/Amber-Music-Platform/releases/latest/download/latest.json",
        "https://raw.githubusercontent.com/Pant0x/Amber-Music-Platform/updater-channel/latest.json"
      ]
    }
  }
}