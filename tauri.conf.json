{
  "build": {
    "beforeDevCommand": "npm run build",
    "devPath": "http://localhost:3000",
    "beforeBuildCommand": "npm run build"
  },
  "package": {
    "productName": "Amber Music Platform",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": true,
      "window": {
        "prefersReducedMotion": true,
        "titleBarStyle": "Hidden",
        "title": "Amber Music Platform"
      },
      "fs": {
        "all": true
      },
      "shell": {
        "all": true
      }
    },
    "windows": [
      {
        "url": "http://localhost:3000",
        "label": "main",
        "title": "Amber Music Platform",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "centering": true,
        "transparent": false,
        "alwaysOnTop": false,
        "decorations": true,
        "fullscreenOnLaunch": false,
        "inchMode": false,
        "windowIcon": "src-tauri/icons/32x32.png",
        "appWindowIcon": "src-tauri/icons/16x16.png"
      }
    ],
    "security": {
      "csp": null
    },
    "bundle": {
      "active": true,
      "targets": "msi",
      "identifier": "com.pant0x.amber-music",
      "icon": [
        "src-tauri/icons/128x128.png",
        "src-tauri/icons/192x192.png",
        "src-tauri/icons/256x256.png",
        "src-tauri/icons/384x384.png",
        "src-tauri/icons/512x512.png"
      ],
      "cargoFlags": [],
      "beforeBuildCommand": "",
      "beforePackCommand": "",
      "adoptPid": true,
      "extGzip": false,
      "identity": "com.pant0x.amber-music",
      "publisher": null,
      "compressAssetDictionary": false,
      "resources": [],
      "fibers": [],
      "folder": "dist"
    },
    "updater": {
      "active": false
    },
    "protocol": {
      "request": {
        "enabled": false
      },
      "response": {
        "enabled": false
      },
      "scheme": "app"
    },
    "build": {
      "distDir": "../.next",
      "devPath": "http://localhost:3000"
    }
  }
}